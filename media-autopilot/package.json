{
  "name": "media-autopilot",
  "version": "1.0.0",
  "description": "Media AutoPilot - イチゴナビ（求人）スカウト・面接管理の自動化デスクトップアプリ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/store.test.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.carma.media-autopilot",
    "productName": "Media AutoPilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
